{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.cli.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dicorre/cli/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "../../packages/shared" }
  ]
}
