{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["src/**/*", "app.config.json"],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.shared.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dicorre/shared/*": ["./src/*"]
    }
  }
}
